rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile photos: anyone signed in can view; only the owner can change.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImageUnder5MB();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Recipe photos: anyone signed in can view; only the uploader can write.
    match /recipeImages/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImageUnder5MB();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
